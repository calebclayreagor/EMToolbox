digraph legend {
  pack=true; packmode="array_ut2"; splines=line;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.28, ranksep=0.20];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [style=invis, arrowhead=none];
  subgraph cluster_1 {
    label="asset type"; labeljust="l"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
    s0 [shape=box, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st0 [shape=plaintext, style="", fixedsize=true, width=1.44, height=0.30, label="notebook\l", fontcolor="#37474f", sortv=1];
    s1 [shape=box3d, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st1 [shape=plaintext, style="", fixedsize=true, width=1.44, height=0.30, label="script\l", fontcolor="#37474f", sortv=1];
    s2 [shape=parallelogram, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st2 [shape=plaintext, style="", fixedsize=true, width=1.44, height=0.30, label="table\l", fontcolor="#37474f", sortv=1];
    s3 [shape=ellipse, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st3 [shape=plaintext, style="", fixedsize=true, width=1.44, height=0.30, label="annotated matrix\l", fontcolor="#37474f", sortv=1];
    s4 [shape=cylinder, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st4 [shape=plaintext, style="", fixedsize=true, width=1.44, height=0.30, label="source data\l", fontcolor="#37474f", sortv=1];
    s5 [shape=trapezium, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st5 [shape=plaintext, style="", fixedsize=true, width=1.3, height=0.30, label="external step\l", fontcolor="#37474f", sortv=1];
    s6 [shape=note, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st6 [shape=plaintext, style="", fixedsize=true, width=1.3, height=0.30, label="checkpoint\l", fontcolor="#37474f", sortv=1];
    s7 [shape=component, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st7 [shape=plaintext, style="", fixedsize=true, width=1.3, height=0.30, label="workflow block\l", fontcolor="#37474f", sortv=1];
    s8 [shape=hexagon, label="", fillcolor="#ffffff", color="#607d8b", penwidth=1.2, width=0.62, height=0.30, sortv=1];
    st8 [shape=plaintext, style="", fixedsize=true, width=1.3, height=0.30, label="figures\l", fontcolor="#37474f", sortv=1];
    {rank=same; s0; st0; s5; st5;} s0 -> st0 -> s5 -> st5;
    {rank=same; s1; st1; s6; st6;} s1 -> st1 -> s6 -> st6;
    {rank=same; s2; st2; s7; st7;} s2 -> st2 -> s7 -> st7;
    {rank=same; s3; st3; s8; st8;} s3 -> st3 -> s8 -> st8;
    {rank=same; s4; st4;} s4 -> st4;
    s0 -> s1;
    s1 -> s2;
    s2 -> s3;
    s3 -> s4;
    s5 -> s6;
    s6 -> s7;
    s7 -> s8;
  }
  subgraph cluster_2 {
    label="availability"; labeljust="l"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
    f0 [shape=square, label="", fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled", width=0.30, height=0.30, fixedsize=true, sortv=2];
    ft0 [shape=plaintext, style="", fixedsize=true, width=2.0, height=0.30, label="this repository\l", fontcolor="#37474f", sortv=2];
    {rank=same; f0; ft0;} f0 -> ft0;
    f1 [shape=square, label="", fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled", width=0.30, height=0.30, fixedsize=true, sortv=2];
    ft1 [shape=plaintext, style="", fixedsize=true, width=2.0, height=0.30, label="Zenodo archive\l", fontcolor="#37474f", sortv=2];
    {rank=same; f1; ft1;} f1 -> ft1;
    f0 -> f1;
    f2 [shape=square, label="", fillcolor="#dcedc8", color="#558b2f", penwidth=1.6, style="filled,dashed", width=0.30, height=0.30, fixedsize=true, sortv=2];
    ft2 [shape=plaintext, style="", fixedsize=true, width=2.0, height=0.30, label="derivable\l", fontcolor="#37474f", sortv=2];
    {rank=same; f2; ft2;} f2 -> ft2;
    f1 -> f2;
    f3 [shape=square, label="", fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled", width=0.30, height=0.30, fixedsize=true, sortv=2];
    ft3 [shape=plaintext, style="", fixedsize=true, width=2.0, height=0.30, label="original source or authors\l", fontcolor="#37474f", sortv=2];
    {rank=same; f3; ft3;} f3 -> ft3;
    f2 -> f3;
  }
}
