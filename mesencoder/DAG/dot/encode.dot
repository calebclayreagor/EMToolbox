      label="checkpoints"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n002 [label="epoch=09.ckpt", shape=note, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
    }
  }
  n001 -> n007;
  n007 -> n002;
  n002 -> n006;
  n001 -> n006;
  n006 -> n000;
  n003 -> n006;
  n003 -> n007;
  n004 -> n006;
  n004 -> n007;
  n005 -> n004;
  n001 -> n000 [label="+X_{feat,mesencoder}", color="#7b1fa2", style=dashed, fontcolor="#7b1fa2", constraint=false];
}