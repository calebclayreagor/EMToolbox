  }
  subgraph cluster_2 {
    label="mesencoder"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="dataset.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n004 [label="lit_module.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n005 [label="model.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n007 [label="training.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n006 [label="prediction.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
