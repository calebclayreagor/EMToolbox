digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="summary.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    subgraph cluster_2 {
      label="development/modeling"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n001 [label="mesencoder.h5ad", shape=ellipse, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
      n002 [label="trajectories.h5ad", shape=ellipse, fillcolor="#dcedc8", color="#558b2f", penwidth=1.6, style="filled,dashed"];
      n000 [label="bifurcation.h5ad", shape=ellipse, fillcolor="#dcedc8", color="#558b2f", penwidth=1.6, style="filled,dashed"];
    }
    subgraph cluster_3 {
      label="features/biomart"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n011 [label="union.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
  }
  subgraph cluster_4 {
    label="mesencoder/notebooks"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n004 [label="01_embedding.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n009 [label="06_magnitude.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n010 [label="07_timing.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n005 [label="02_expression.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n006 [label="03_trajectories.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n007 [label="04_correlation.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n008 [label="05_modules.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  subgraph cluster_fig {
    label="figures/mesencoder/"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    FIG [label="panels ×22\n(4 subtrees)", shape=hexagon, style=filled, fillcolor="#e3f2fd", color="#1565c0"];
  }
  n001 -> n004;
  n004 -> n000;
  n004 -> FIG;
  n000 -> n005;
  n001 -> n005;
  n011 -> n005;
  n005 -> FIG;
  n000 -> n006;
  n006 -> FIG;
  n000 -> n007;
  n007 -> FIG;
  n000 -> n008;
  n008 -> FIG;
  n002 -> n009;
  n011 -> n009;
  n003 -> n009;
  n009 -> FIG;
  n002 -> n010;
  n011 -> n010;
  n003 -> n010;
  n010 -> FIG;
  n001 -> n000 [label="-3215 cells", color="#7b1fa2", style=dashed, fontcolor="#7b1fa2", constraint=false];
}