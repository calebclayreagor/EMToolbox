digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n002 [label="summary.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    subgraph cluster_2 {
      label="development/modeling"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n001 [label="trajectories.h5ad", shape=ellipse, fillcolor="#dcedc8", color="#558b2f", penwidth=1.6, style="filled,dashed"];
      n000 [label="signatures.h5ad", shape=ellipse, fillcolor="#dcedc8", color="#558b2f", penwidth=1.6, style="filled,dashed"];
    }
    subgraph cluster_3 {
      label="features/biomart"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n007 [label="*.csv\n×4", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
    subgraph cluster_4 {
      label="results/gseapy"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n008 [label="<dataset>.csv\n×3", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
  }
  subgraph cluster_5 {
    label="development/notebooks"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="01_expression.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n004 [label="02_signatures.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n005 [label="03_modules.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n006 [label="04_ontology.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  subgraph cluster_fig {
    label="figures/development/"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    FIG [label="panels ×6\n(3 subtrees)", shape=hexagon, style=filled, fillcolor="#e3f2fd", color="#1565c0"];
  }
  n001 -> n003;
  n007 -> n003;
  n003 -> FIG;
  n001 -> n004;
  n007 -> n004;
  n002 -> n004;
  n004 -> n000;
  n004 -> FIG;
  n007 -> n005;
  n002 -> n005;
  n005 -> FIG;
  n007 -> n006;
  n006 -> n008;
  n001 -> n000 [label="+4 obs", color="#7b1fa2", style=dashed, fontcolor="#7b1fa2", constraint=false];
}