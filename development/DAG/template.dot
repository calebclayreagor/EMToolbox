digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n002 [label="summary.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    subgraph cluster_2 {
      label="development"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      subgraph cluster_3 {
        label="processed"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
        n000 [label="<dataset>.h5ad", shape=ellipse, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
      }
      subgraph cluster_4 {
        label="trajectories"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
        n001 [label="<dataset>.h5ad", shape=ellipse, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
      }
    }
    subgraph cluster_5 {
      label="features"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n005 [label="<dataset>.txt", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
    subgraph cluster_6 {
      label="ref/AnimalTFDBv4"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n006 [label="Mus_musculus_TF", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
    }
    subgraph cluster_7 {
      label="unzip"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n007 [label="<dataset>", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
    }
  }
  subgraph cluster_8 {
    label="development/<dataset>"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="preprocessing.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n004 [label="trajectory.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  subgraph cluster_fig {
    label="figures/development/"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    FIG [label="panels ×3\n(3 subtrees)", shape=hexagon, style=filled, fillcolor="#e3f2fd", color="#1565c0"];
  }
  n002 -> n003;
  n007 -> n003;
  n003 -> n000;
  n003 -> FIG;
  n000 -> n004;
  n006 -> n004;
  n004 -> n001;
  n004 -> n005;
  n004 -> FIG;
  n007 -> n004 [style=dotted, penwidth=1.4, fontcolor="#546e7a", fontsize=10, label="rRNAModifications"];
}