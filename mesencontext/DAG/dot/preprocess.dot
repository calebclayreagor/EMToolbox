digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n000 [label="CCCA_summary.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    subgraph cluster_2 {
      label="cancer/vertebrate/\nCCCA/pancan"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n001 [label="malignant.h5ad", shape=ellipse, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
    }
    subgraph cluster_3 {
      label="features/biomart"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n004 [label="union.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
    subgraph cluster_4 {
      label="unzip"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n005 [label="3CA\n×103 datasets", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
    }
  }
  subgraph cluster_5 {
    label="mesencontext/scripts"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n002 [label="load.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n003 [label="merge.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  n000 -> n003;
  n004 -> n003;
  n003 -> n001;
  n005 -> n003;
  n002 -> n003;
}