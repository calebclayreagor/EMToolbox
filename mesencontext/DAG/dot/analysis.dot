digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n002 [label="summary.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    subgraph cluster_2 {
      label="cancer/vertebrate/\nCCCA/pancan"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n000 [label="malignant.h5ad", shape=ellipse, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
      n001 [label="signatures.h5ad", shape=ellipse, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
    }
    subgraph cluster_3 {
      label="features/biomart"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n008 [label="*.csv\n×4", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
    subgraph cluster_4 {
      label="results"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n009 [label="CCCA\n×3", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
  }
  subgraph cluster_5 {
    label="mesencontext/notebooks"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="01_overview.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n004 [label="02_expression.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n005 [label="03_signatures.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n006 [label="04_cooption.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  subgraph cluster_6 {
    label="mesencontext/spec"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n007 [label="log.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  subgraph cluster_fig {
    label="figures/\nmesencontext/pancan/"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    FIG [label="panels ×4", shape=hexagon, style=filled, fillcolor="#e3f2fd", color="#1565c0"];
  }
  n000 -> n003;
  n003 -> n009;
  n003 -> FIG;
  n000 -> n004;
  n004 -> FIG;
  n000 -> n005;
  n008 -> n005;
  n002 -> n005;
  n005 -> n001;
  n005 -> n009;
  n005 -> FIG;
  n000 -> n006;
  n007 -> n006;
  n006 -> n009;
  n006 -> FIG;
  n000 -> n001 [label="+3 obs", color="#7b1fa2", style=dashed, fontcolor="#7b1fa2", constraint=false];
}