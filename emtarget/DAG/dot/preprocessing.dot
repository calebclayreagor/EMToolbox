digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data/ref"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n002 [label="CELLxGENE\n×2", shape=cylinder, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
  }
  subgraph cluster_2 {
    label="data/results/\nemtarget/safety"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="*.csv\n×2", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  subgraph cluster_3 {
    label="emtarget/scripts"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n000 [label="pseudobulk.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n001 [label="safety.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  n002 -> n000;
  n000 -> n002;
  n002 -> n001;
  n001 -> n003;
}