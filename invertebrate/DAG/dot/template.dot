digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n002 [label="summary.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    subgraph cluster_2 {
      label="cancer/invertebrate/\n<dataset>"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n001 [label="<malignant>.h5ad", shape=ellipse, fillcolor="#dcedc8", color="#558b2f", penwidth=1.6, style="filled,dashed"];
      n000 [label="signatures.h5ad", shape=ellipse, fillcolor="#c8e6c9", color="#2e7d32", penwidth=2.2, style="filled"];
    }
    subgraph cluster_3 {
      label="features/orthofinder/\n<dataset>"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n005 [label="*.csv\n×4", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
    subgraph cluster_4 {
      label="results/invertebrate"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n006 [label="<dataset>.csv", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
  }
  subgraph cluster_5 {
    label="invertebrate/\n<dataset>/notebooks"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="01_expression.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n004 [label="02_signatures.ipynb", shape=box, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  subgraph cluster_fig {
    label="figures/invertebrate/\n<dataset>/"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    FIG [label="panels ×4", shape=hexagon, style=filled, fillcolor="#e3f2fd", color="#1565c0"];
  }
  n001 -> n003;
  n003 -> n006;
  n003 -> FIG;
  n001 -> n004;
  n005 -> n004;
  n002 -> n004;
  n004 -> n000;
  n004 -> FIG;
  n001 -> n000 [label="+4 obs", color="#7b1fa2", style=dashed, fontcolor="#7b1fa2", constraint=false];
}