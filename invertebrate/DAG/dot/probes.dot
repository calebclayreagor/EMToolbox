digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="data/ref"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n002 [label="HydraGenomeProject", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
  }
  subgraph cluster_2 {
    label="data/unzip"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n003 [label="GSE56287\n×4", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
  }
  subgraph cluster_3 {
    label="invertebrate/holigactis/\nscripts/probes"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n000 [label="fasta.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    n001 [label="genes.py", shape=box3d, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
  }
  n003 -> n000;
  n000 -> n003;
  n002 -> n001;
  n003 -> n001;
  n001 -> n003;
}