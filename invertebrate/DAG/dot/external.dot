digraph G {
  rankdir=LR; splines=spline;
  graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11, style="filled", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#78909c", arrowsize=0.7];
  subgraph cluster_1 {
    label="<external>"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    n000 [label="blastn", shape=trapezium, fillcolor="#fff3e0", color="#ef6c00", penwidth=1.4, style="filled"];
    n001 [label="makeblastdb", shape=trapezium, fillcolor="#fff3e0", color="#ef6c00", penwidth=1.4, style="filled"];
    n002 [label="OrthoFinder", shape=trapezium, fillcolor="#fff3e0", color="#ef6c00", penwidth=1.4, style="filled"];
  }
  subgraph cluster_2 {
    label="data"; style="rounded"; color="#b0bec5"; fontsize=13; fontcolor="#37474f";
    subgraph cluster_3 {
      label="ref"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n004 [label="ensembl\n×2", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
      n003 [label="HydraGenomeProject\n×10", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
    }
    subgraph cluster_4 {
      label="results"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n005 [label="orthofinder\n×4", shape=parallelogram, fillcolor="#e3f2fd", color="#1565c0", penwidth=1, style="filled"];
    }
    subgraph cluster_5 {
      label="unzip"; style="rounded"; color="#b0bec5"; fontsize=12; fontcolor="#37474f";
      n006 [label="GSE56287\n×17", shape=cylinder, fillcolor="#eceff1", color="#90a4ae", penwidth=1, style="filled"];
    }
  }
  n003 -> n001;
  n001 -> n003;
  n006 -> n000;
  n000 -> n006;
  n002 -> n005;
  n004 -> n002;
  n003 -> n002;
}